[Unit]
Description=Laya decision daemon (CPU)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/local-laya
EnvironmentFile=-%h/Projects/local-laya/laya.env
Environment=LAYA_HOST=127.0.0.1 LAYA_PORT=8123
Environment=LAYA_DEVICE=cpu LAYA_PRELOAD=1 LAYA_THREADS=8
ExecStart=%h/Projects/local-laya/.venv/bin/python -m laya.serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
