#!/usr/bin/env bash
# laya-mcp-install — register the laya MCP proxy (and pi extension/hooks where
# those apply) with every agent. Idempotent; pass agent names to restrict.
set -euo pipefail
cd "$(dirname "$0")"; HERE=$PWD

PY=$HERE/.venv/bin/python
SRV=$HERE/laya-mcp.py
PI_EXT=$HERE/../ask-laya/pi-extension/laya.js
STATE=${OMARCHY_LOCAL_AI_STATE:-$HOME/.local/state/omarchy/local-ai}

ok() { printf '  ok %s\n' "$1"; }
skip() { printf '  -  %s\n' "$1"; }

install_codex() {
  local f=$HOME/.codex/config.toml
  [[ -f $f ]] || { skip "codex: no $f"; return; }
  if grep -q '^\[mcp_servers\.laya\]' "$f"; then skip "codex: already configured"; return; fi
  cat >>"$f" <<EOF

[mcp_servers.laya]
command = "$PY"
args = ["$SRV"]
startup_timeout_sec = 15
tool_timeout_sec = 60
EOF
  ok "codex: $f"
}

install_claude() {
  command -v claude >/dev/null || { skip "claude: not installed"; return; }
  # `claude mcp list` health-checks every server (~40s); check the config file instead
  jq -e '.mcpServers.laya' "$HOME/.claude.json" >/dev/null 2>&1 || \
    claude mcp add --scope user laya -- "$PY" "$SRV" >/dev/null
  local f=$HOME/.claude/settings.json
  [[ -f $f ]] || echo '{}' >"$f"
  # merge per event: append a laya-gate hook only if the event's array lacks one
  jq --arg g "$PY $HERE/laya-gate.py" '
    def ensure($ev; $matcher; $mode):
      .hooks[$ev] = (.hooks[$ev] // []) +
        (if (.hooks[$ev] // []) | map(($matcher == "" or .matcher == $matcher) and
            ([.hooks[].command] | any(contains("laya-gate")))) | any
         then []
         else [({hooks: [{type: "command", command: ($g + " " + $mode)}]}
                + (if $matcher == "" then {} else {matcher: $matcher} end))]
         end);
    .hooks = (.hooks // {})
    | ensure("PreToolUse"; "Read"; "pretool")
    | ensure("PreToolUse"; "Bash"; "pretool")
    | ensure("PreToolUse"; "mcp__laya__.*"; "pretool")
    | ensure("PostToolUse"; "Read"; "posttool")
    | ensure("UserPromptSubmit"; ""; "prompt")' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  ok "claude: MCP + hooks in $f"
}

install_opencode() {
  local d=$HOME/.config/opencode
  local f=$d/opencode.json
  mkdir -p "$d/plugins"
  [[ -f $f ]] || echo '{}' >"$f"
  jq -e '.mcp.laya' "$f" >/dev/null 2>&1 || {
    jq --arg c "$PY" --arg a "$SRV" '.mcp.laya={type:"local",command:[$c,$a],enabled:true}' \
      "$f" >"$f.tmp" && mv "$f.tmp" "$f"; }
  # hard enforcement plugin (tool.execute.before/after -> laya-gate.py)
  local plug=$HERE/../ask-laya/opencode-plugin/laya.js
  [[ -f $plug ]] && cp -f "$plug" "$d/plugins/laya.js"
  ok "opencode: $f + plugins/laya.js"
}

install_crush() {
  local d=$STATE/agents/crush
  local f=$d/crush/crush.json
  mkdir -p "$d/crush"
  [[ -f $f ]] || echo '{}' >"$f"
  if jq -e '.mcp.laya' "$f" >/dev/null 2>&1; then skip "crush: already configured"; return; fi
  jq --arg c "$PY" --arg a "$SRV" '.mcp.laya={type:"stdio",command:$c,args:[$a]}' \
    "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  ok "crush: $f (re-run this after each 'open' if the plugin regenerates crush.json)"
}

install_grok() {
  command -v grok >/dev/null || { skip "grok: not installed"; return; }
  GROK_HOME=$STATE/agents/grok grok mcp add laya "$PY" -- "$SRV" >/dev/null 2>&1 \
    && ok "grok: $STATE/agents/grok"
}

install_copilot() {
  local d=$HOME/.copilot
  local f=$d/mcp-config.json
  mkdir -p "$d"
  [[ -f $f ]] || echo '{"mcpServers":{}}' >"$f"
  if jq -e '.mcpServers.laya' "$f" >/dev/null 2>&1; then skip "copilot: already configured"; return; fi
  jq --arg c "$PY" --arg a "$SRV" '.mcpServers.laya={type:"stdio",command:$c,args:[$a]}' \
    "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  ok "copilot: $f"
}

install_hermes() {
  command -v hermes >/dev/null || { skip "hermes: not installed"; return; }
  hermes mcp list 2>/dev/null | grep -qi laya || \
    yes | hermes mcp add laya --command "$PY" --args "$SRV" >/dev/null 2>&1
  # hard enforcement via shell hooks (config.yaml)
  python3 - "$PY" "$HERE/laya-gate.py" "$HOME/.hermes/config.yaml" <<'PYEOF' 2>/dev/null || true
import sys, yaml
py, gate, f = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cfg = yaml.safe_load(open(f)) or {}
except OSError:
    cfg = {}
hooks = cfg.setdefault("hooks", {})
def has(event, cmd):
    return any(cmd in (h.get("command") or "") for h in hooks.get(event, []))
G = f"{py} {gate}"
hooks.setdefault("pre_tool_call", [])
if not has("pre_tool_call", G):
    hooks["pre_tool_call"] += [
        {"matcher": "read_file|terminal", "command": f"{G} pretool hermes", "timeout": 20},
        {"matcher": "laya", "command": f"{G} pretool hermes", "timeout": 10}]
hooks.setdefault("post_tool_call", [])
if not has("post_tool_call", G):
    hooks["post_tool_call"].append(
        {"matcher": "read_file", "command": f"{G} posttool hermes", "timeout": 20})
hooks.setdefault("pre_llm_call", [])
if not has("pre_llm_call", G):
    hooks["pre_llm_call"].append({"command": f"{G} prompt hermes", "timeout": 15})
cfg["hooks_auto_accept"] = True
open(f, "w").write(yaml.dump(cfg, sort_keys=False))
PYEOF
  ok "hermes: MCP + hooks in ~/.hermes/config.yaml"
}

install_omp() { install_pi "$1"; }
install_pi() {
  local a=$1 d=$STATE/agents/$a/extensions
  mkdir -p "$d"
  if [[ ! -f $PI_EXT ]]; then skip "$a: $PI_EXT missing"; return; fi
  cp -f "$PI_EXT" "$d/laya.js" && ok "$a: $d/laya.js (native extension — $a has no MCP)"
}

agents=("$@")
wanted() { ((${#agents[@]} == 0)) || printf '%s\n' "${agents[@]}" | grep -qx "$1"; }
for a in claude codex opencode crush grok copilot hermes pi omp; do
  wanted "$a" || continue
  "install_$a" "$a" || echo "  !! $a failed"
done
